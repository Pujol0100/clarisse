# Copie para .env e ajuste. Nenhum valor aqui é secreto.
CLARISSE_PORTA=8765

CLARISSE_OLLAMA_URL=http://127.0.0.1:11434
CLARISSE_OLLAMA_BIN=~/.local/ollama/bin/ollama
CLARISSE_MODELO=gemma4:e4b-it-qat

CLARISSE_WHISPER_MODELO=small
CLARISSE_WHISPER_DISPOSITIVO=cpu

# Voz do Kokoro (na máquina): vozes e pesos. pf_dora é a brasileira; af_bella dá mais ânimo.
CLARISSE_VOZ=pf_dora*0.8+af_bella*0.2
CLARISSE_VOZ_VELOCIDADE=1.08

CLARISSE_CLAUDE_MODELO=sonnet
CLARISSE_CLAUDE_TIMEOUT=600
CLARISSE_CLAUDE_TETO_USD=1.0

# Cidade usada quando você pergunta do tempo sem dizer qual
CLARISSE_CIDADE=

# De quantos em quantos minutos a Clarisse pede ao Linux para atualizar a agenda do Outlook
CLARISSE_AGENDA_INTERVALO_MINUTOS=5

# Pasta do cofre do Obsidian para buscar e ler notas (vazio: sem busca nas notas)
CLARISSE_COFRE_DE_NOTAS=

# true volta a mandar pedidos ao Claude (pesquisa, criar compromisso, navegador, etapas)
CLARISSE_USAR_CLAUDE=false
